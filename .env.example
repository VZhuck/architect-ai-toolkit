PROJECTS=007,101

# Raw Requirements
# Default Jira keys for /load-raw-req when no ID is passed on the command line.
JIRA_KEYS=CAP-123,ABC-45,ABC-99

# Convert Markdown To Word
# Default reference .docx template for /md-to-word when --template is not passed.
SAD_TEMPLATE=./test-data/architecture-template.docx

# Summarize Meeting Decisions
# Default folder of meeting notes for /summarize-meeting-decisions when no meetingFilePath is passed.
MEETING_NOTES_FOLDER=./test-data/meeting-notes

ADL_PATH=./sad/07.Decision-Acceptance-Board.md

# Non-Functional Requirements
# Target NFR document for /aait:nfr-detect, /aait:nfr-refine, /aait:nfr-publish and
# /aait:nfr-validate when --nfr-path is not passed. If this is unset too, the skill
# lists the documents in sad/ and asks which to use, or proposes a new one.
# Draft and trace files are always derived from this path into ai-workflow/nfr/ -
# never into sad/, where /md-to-word would sweep them into the Word deliverable.
NFR_PATH=./sad/08.Non-Functional-Requirements.md
# To delete
# ADO_ORGANIZATION_URL=https://dev.azure.com/{your-organization}
# CAPABILITY_ID=111111
# FEATURE_IDS=111112,111113
# ADO_PAT=FAKE_PAT_8472956183027481920364857291384756
